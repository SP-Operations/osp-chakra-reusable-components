{
  "name": "st-peter-ui",
  "version": "0.1.1",
  "description": "A Chakra UI-based design system for St. Peter applications",
  "author": "Diana Mae Desuacido",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean"
  },
  "keywords": [
    "chakra-ui",
    "ui-library",
    "react",
    "design-system"
  ],
  "peerDependencies": {
    "@ark-ui/react": ">=5.26.1",
    "@chakra-ui/react": ">=3.0.0",
    "@emotion/react": ">=11.0.0",
    "@emotion/styled": ">=11.0.0",
    "framer-motion": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.0",
    "react-icons": "^5.5.0"
  }
}
